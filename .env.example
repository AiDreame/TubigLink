# AquaLink PH Environment Variables
# Copy this to .env and fill in your values

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# For PostgreSQL (Supabase/Neon):
# DATABASE_URL="postgresql://user:password@host:5432/aqualink?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# SMS / OTP (Semaphore or Twilio)
# SEMAPHORE_API_KEY="your-semaphore-key"
# TWILIO_ACCOUNT_SID="your-twilio-sid"
# TWILIO_AUTH_TOKEN="your-twilio-token"
# TWILIO_PHONE_NUMBER="+1234567890"

# PayMongo (Payments)
# PAYMONGO_SECRET_KEY="sk_test_..."
# PAYMONGO_PUBLIC_KEY="pk_test_..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AquaLink PH"
NEXT_PUBLIC_DEFAULT_LAT="14.5995"
NEXT_PUBLIC_DEFAULT_LNG="120.9842"
NEXT_PUBLIC_DEFAULT_CITY="Manila"

# Optional PayMongo webhook signing secret (used by a later webhook milestone)
# PAYMONGO_WEBHOOK_SECRET="whsec_..."
# AES-256-GCM key material (use unique random secrets in production)
OTP_ENC_KEY="dev-otp-encryption-key-change-me"
PAYOUT_ENC_KEY="dev-payout-encryption-key-change-me"

# Discord two-way support bridge (Aug 18; per-ticket channels Phase 2a, Sep 9)
# When these are unset the feature is a graceful no-op.
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/.../<token>"
# DISCORD_BOT_TOKEN=""
# DISCORD_WEBHOOK_SECRET=""          # shared secret for /api/webhooks/discord
# DISCORD_SUPPORT_CHANNEL_ID=""      # legacy #support channel (thread flow)
# DISCORD_GUILD_ID=""                # guild id (required for per-ticket channels)
# DISCORD_TICKETS_CATEGORY_ID=""     # "Tickets" category (defaults to the live id)
# DISCORD_CLOSED_CATEGORY_ID=""      # "Closed Tickets" category (defaults to live id)
# DISCORD_BOT_SELF_ID=""             # bot's own user id (loop guard)
# Audit-trail live delivery (Phase 2, Sep 9): per-report Discord channels under
# the "Audit" category. Channels default to the owner's live guild ids — set
# these only to override. No-op when DISCORD_BOT_TOKEN is unset.
# DISCORD_AUDIT_CATEGORY_ID=""       # "Audit" category (defaults to the live id)
# DISCORD_AUDIT_USERS_CHANNEL_ID=""     # defaults to live #audit-users
# DISCORD_AUDIT_STATIONS_CHANNEL_ID=""  # defaults to live #audit-stations
# DISCORD_AUDIT_ORDERS_CHANNEL_ID=""    # defaults to live #audit-orders
# DISCORD_AUDIT_PAYMENTS_CHANNEL_ID=""  # defaults to live #audit-payments
# DISCORD_AUDIT_DISPUTES_CHANNEL_ID=""  # defaults to live #audit-disputes
# DISCORD_AUDIT_ADMINS_CHANNEL_ID=""    # defaults to live #audit-admins
