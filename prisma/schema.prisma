generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── USER ────────────────────────────────────────────
model User {
  id         String   @id @default(cuid())
  phone      String   @unique
  email      String?  @unique
  name       String?
  password   String? // For email/password auth (bcrypt)
  role       String   @default("CUSTOMER") // CUSTOMER | PROVIDER | ADMIN
  avatar     String?
  isVerified Boolean  @default(false)
  // Account deletion (Apple 5.1.1(v)): soft-deleted users keep their row for
  // order/audit history with PII anonymized; hard delete only when no history.
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stations       Station[]
  orders         Order[]
  addresses      Address[]
  reviews        Review[]
  notifications  Notification[]
  paymentMethods PaymentMethod[]

  // Compliance & verification relations
  verifiedDocuments   StationDocument[]     @relation("DocumentVerifier")
  verifiedSteps       StationVerification[] @relation("StepVerifier")
  verificationActions VerificationLog[]     @relation("ActionPerformer")

  // Staff relations
  staffInvited     StationStaff[] @relation("StaffInviter")
  staffRecords     StationStaff[] @relation("StaffUser")
  refundsRequested Refund[]
  customerDisputes Dispute[]      @relation("CustomerDisputes")
  supportTickets   SupportTicket[] @relation("TicketCreator")
  otpCodes OtpCode[]
}

// ─── STATION (Water Refilling Station) ──────────────
model Station {
  id           String   @id @default(cuid())
  userId       String
  name         String
  slug         String   @unique
  description  String?
  logo         String?
  banner       String?
  phone        String?
  address      String
  barangay     String
  city         String
  province     String
  latitude     Float?
  longitude    Float?
  rating       Float    @default(0)
  totalReviews Int      @default(0)
  deliveryFee  Float    @default(0)
  minOrder     Float    @default(0)
  isActive     Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  openingTime  String   @default("06:00")
  closingTime  String   @default("21:00")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ── Compliance fields ──
  businessType          String? // SOLE_PROP | CORPORATION | PARTNERSHIP | COOPERATIVE
  tin                   String? // Tax Identification Number
  onboardingStep        Int       @default(0)
  onboardingComplete    Boolean   @default(false)
  onboardingSubmittedAt DateTime?
  complianceScore       Float     @default(0)
  provisionalUntil      DateTime?
  approvedAt            DateTime?
  rejectionReason       String?
  lastComplianceCheck   DateTime?

  user          User           @relation(fields: [userId], references: [id])
  products      Product[]
  deliveryZones DeliveryZone[]
  orders        Order[]
  reviews       Review[]

  // Compliance & verification relations
  documents         StationDocument[]
  verificationSteps StationVerification[]
  verificationLogs  VerificationLog[]

  // Staff relations
  staff    StationStaff[]
  disputes Dispute[]
  payouts  Payout[]
  payoutMethod       String?
  payoutBankName     String?
  payoutAccountName  String?
  payoutAccountLast4 String?
  payoutDetails      String?
  acceptedPaymentMethods String @default("[\"gcash\"]") // JSON array of PayMongo payment method ids the station accepts (gcash | paymaya | grab_pay | shopee_pay | card | dob | billease | qrph)
}

// ─── PRODUCT (Water Type) ───────────────────────────
model Product {
  id          String   @id @default(cuid())
  stationId   String
  name        String
  type        String   @default("PURIFIED") // PURIFIED | MINERAL | ALKALINE
  size        String   @default("5-gallon")
  price       Float    @default(0)
  stock       Int      @default(0)
  isAvailable Boolean  @default(true)
  image       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  station    Station     @relation(fields: [stationId], references: [id])
  orderItems OrderItem[]
}

// ─── DELIVERY ZONE ──────────────────────────────────
model DeliveryZone {
  id               String @id @default(cuid())
  stationId        String
  barangay         String
  city             String
  deliveryFee      Float  @default(0)
  estimatedMinutes Int    @default(30)

  station Station @relation(fields: [stationId], references: [id])

  @@unique([stationId, barangay, city])
}

// ─── ORDER ──────────────────────────────────────────
model Order {
  id                    String    @id @default(cuid())
  userId                String
  stationId             String
  status                String    @default("PENDING") // PENDING | ACCEPTED | PREPARING | OUT_FOR_DELIVERY | DELIVERED | CANCELLED
  orderType             String    @default("ONCE") // ONCE | RECURRING
  recurringDay          String? // MON | TUE | WED | THU | FRI | SAT | SUN
  subtotal              Float     @default(0)
  deliveryFee           Float     @default(0)
  total                 Float     @default(0)
  paymentMethod         String    @default("COD") // COD | GCASH | CARD | PAYMAYA
  paymentStatus         String    @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  paymentId             String? // PayMongo payment intent ID
  paymentIntentId       String?   @unique
  paymentMethodId       String?
  paymentPaidAt         DateTime?
  paymentFailedAt       DateTime?
  paymentFailureCode    String?
  paymentFailureMessage String?
  paymentRefundedAt     DateTime?
  paymentRefundedAmount Int?
  paymentCurrency       String    @default("PHP")
  amountCentavos        Int?
  commissionCentavos    Int?
  processingFeeCentavos Int?
  stationNetCentavos    Int?
  commissionRateBps     Int?
  deliveredAt           DateTime?
  deliveryConfirmedAt   DateTime?
  disputeDeadlineAt     DateTime?
  payoutEligibleAt      DateTime?
  deliveryPhoto         String? // URL path to the delivery evidence photo (uploads/), set by station staff before confirmation
  notes                 String?
  addressId             String
  driverId              String? // Assigned driver (StationStaff)
  deliveryOrder         Int? // Sequence position in driver's route
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user           User             @relation(fields: [userId], references: [id])
  station        Station          @relation(fields: [stationId], references: [id])
  address        Address          @relation(fields: [addressId], references: [id])
  driver         StationStaff?    @relation(fields: [driverId], references: [id])
  items          OrderItem[]
  review         Review?
  paymentEvents  PaymentEvent[]
  disputes       Dispute[]
  supportTickets SupportTicket[]
  payoutItems    PayoutItem[]
  paymentAttempts PaymentAttempt[]
  refunds         Refund[]
}

// ─── ORDER ITEM ─────────────────────────────────────
model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Float

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

// ─── REVIEW ─────────────────────────────────────────
model Review {
  id        String   @id @default(cuid())
  userId    String
  stationId String
  orderId   String   @unique
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  station Station @relation(fields: [stationId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])
}

// ─── ADDRESS ────────────────────────────────────────
model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String   @default("Home") // Home | Office | Other
  name      String
  phone     String
  street    String
  barangay  String
  city      String
  province  String
  zipCode   String?
  landmark  String?
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]
}

// ─── PAYMENT METHOD ─────────────────────────────────
model PaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  type      String // GCASH | CARD | PAYMAYA
  details   String // JSON: { phone, cardLast4, etc. }
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type])
}

// ─── NOTIFICATION ───────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // ORDER_NEW | ORDER_STATUS | PAYOUT | DISPUTE | SYSTEM
  title     String
  body      String
  link      String? // relative path, e.g. /orders/<id> or /dashboard/orders
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════
// COMPLIANCE & VERIFICATION MODELS
// ═══════════════════════════════════════════════════════

// ─── STATION DOCUMENT ───────────────────────────────
// Uploaded documents for compliance verification
// Types: DTI_CERT | SEC_CERT | BIR_2303 | MAYORS_PERMIT | BARANGAY_CLEARANCE |
//        SANITARY_PERMIT | WATER_TEST_BACTERIOLOGICAL | WATER_TEST_PHYSICAL_CHEMICAL |
//        GOVT_ID | FIRE_SAFETY_CERT | PROOF_OF_ADDRESS | STATION_PHOTO | VIDEO_WALKTHROUGH
// Verification statuses: PENDING | VERIFIED | REJECTED | EXPIRED
model StationDocument {
  id                 String    @id @default(cuid())
  stationId          String
  type               String // Document type (see comment above for values)
  fileUrl            String
  fileName           String
  fileSize           Int       @default(0)
  mimeType           String
  expiryDate         DateTime? // For permits with expiry dates
  verificationStatus String    @default("PENDING") // PENDING | VERIFIED | REJECTED | EXPIRED
  rejectionReason    String?
  verifiedById       String?
  verifiedAt         DateTime?
  uploadedAt         DateTime  @default(now())
  notes              String?
  discordMessageId   String? // Discord message id of the station-docs review embed (doc approval flow, Sep 9)
  discordChannelId   String? // Discord channel id the review embed was posted in

  station    Station @relation(fields: [stationId], references: [id])
  verifiedBy User?   @relation("DocumentVerifier", fields: [verifiedById], references: [id])

  @@index([stationId, type])
  @@index([stationId, verificationStatus])
  @@index([verifiedById])
}

// ─── STATION VERIFICATION ───────────────────────────
// Tracks each step in the station verification/onboarding process
// Steps: BUSINESS_INFO, DOCUMENTS, LOCATION_VERIFICATION, DELIVERY_ZONES, PRODUCTS, FINAL_REVIEW
// Statuses: PENDING | IN_PROGRESS | PASSED | FAILED | SKIPPED
model StationVerification {
  id           String   @id @default(cuid())
  stationId    String
  step         String // Name of the verification step
  status       String   @default("PENDING") // PENDING | IN_PROGRESS | PASSED | FAILED | SKIPPED
  verifiedById String?
  notes        String?
  timestamp    DateTime @default(now())

  station    Station @relation(fields: [stationId], references: [id])
  verifiedBy User?   @relation("StepVerifier", fields: [verifiedById], references: [id])

  @@index([stationId, step])
  @@index([stationId, status])
}

// ─── VERIFICATION LOG ───────────────────────────────
// Audit trail for all compliance-related actions
// Actions: DOCUMENT_UPLOADED | DOCUMENT_VERIFIED | DOCUMENT_REJECTED | STEP_PASSED |
//          STEP_FAILED | STATION_APPROVED | STATION_REJECTED | COMPLIANCE_CHECK |
//          PROVISIONAL_GRANTED | PROVISIONAL_EXPIRED | ONBOARDING_SUBMITTED
model VerificationLog {
  id            String   @id @default(cuid())
  stationId     String
  action        String // Action type (see comment above for values)
  performedById String?
  details       String? // JSON payload with action-specific data
  createdAt     DateTime @default(now())

  station     Station @relation(fields: [stationId], references: [id])
  performedBy User?   @relation("ActionPerformer", fields: [performedById], references: [id])

  @@index([stationId, createdAt])
  @@index([stationId, action])
  @@index([performedById])
}

// ═══════════════════════════════════════════════════════
// STAFF & PERMISSIONS MODELS
// ═══════════════════════════════════════════════════════

// ─── STATION STAFF ─────────────────────────────────
// Staff/employees of a water refilling station
// Roles: STAFF | MANAGER | ADMIN
// Statuses: INVITED | ACTIVE | DEACTIVATED
model StationStaff {
  id          String    @id @default(cuid())
  stationId   String
  email       String
  name        String?
  phone       String?
  permissions String    @default("{}") // JSON string of permission keys
  role        String    @default("STAFF") // STAFF | MANAGER | ADMIN
  status      String    @default("INVITED") // INVITED | ACTIVE | DEACTIVATED
  inviteToken String    @unique
  userId      String? // Linked user account after acceptance
  invitedById String
  acceptedAt  DateTime?
  invitedAt   DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  station   Station @relation(fields: [stationId], references: [id])
  invitedBy User    @relation("StaffInviter", fields: [invitedById], references: [id])
  user      User?   @relation("StaffUser", fields: [userId], references: [id])

  assignedOrders Order[] // Orders assigned to this driver

  @@index([stationId, status])
  @@index([inviteToken])
  @@index([email])
}

// ─── PAYMENT DOMAIN ─────────────────────────────────
model PaymentEvent {
  id              String    @id @default(cuid())
  provider        String    @default("PAYMONGO")
  providerEventId String
  eventType       String
  orderId         String?
  paymentIntentId String?
  payload         String
  processedAt     DateTime?
  processingError String?
  createdAt       DateTime  @default(now())
  order           Order?    @relation(fields: [orderId], references: [id])

  @@unique([provider, providerEventId])
  @@index([paymentIntentId])
  @@index([orderId])
}

model PaymentAttempt {
  id              String   @id @default(cuid())
  orderId         String
  idempotencyKey  String   @unique
  paymentIntentId String?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  order           Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Refund {
  id               String    @id @default(cuid())
  orderId          String
  providerRefundId String?   @unique
  amountCentavos   Int
  reason           String
  status           String    @default("PENDING")
  requestedById    String?
  requestedAt      DateTime  @default(now())
  completedAt      DateTime?
  failureMessage   String?
  order            Order     @relation(fields: [orderId], references: [id])
  requestedBy      User?     @relation(fields: [requestedById], references: [id])
  dispute          Dispute?

  @@index([orderId])
  @@index([status])
}

model Dispute {
  id                 String    @id @default(cuid())
  orderId            String
  customerId         String
  stationId          String
  type               String
  status             String    @default("OPEN")
  description        String
  evidence           String?
  amountHeldCentavos Int
  stationResponse    String?
  stationRespondedAt DateTime?
  responseDeadlineAt DateTime
  openedAt           DateTime  @default(now())
  resolution         String?
  resolvedAt         DateTime?
  refundId           String?   @unique
  // Discord two-way support bridge (Aug 18). When configured, a dispute
  // mirrors into a support thread; inbound support replies append
  // DisputeMessage rows so the conversation is 3-party visible in-app.
  discordThreadId    String?
  discordChannelId   String?
  messages           DisputeMessage[]
  order              Order     @relation(fields: [orderId], references: [id])
  customer           User      @relation("CustomerDisputes", fields: [customerId], references: [id])
  station            Station   @relation(fields: [stationId], references: [id])
  refund             Refund?   @relation(fields: [refundId], references: [id])

  @@index([stationId, status])
  @@index([orderId])
  @@index([responseDeadlineAt])
  @@index([discordThreadId])
  @@index([discordChannelId])
}

// ─── SUPPORT TICKET (general issue report) ──────────
// The general "Report an issue" entry (Aug 19, owner direction). Unlike a
// Dispute, a ticket is NOT order-bound: it opens from the floating
// "Report an issue" button on any page and may optionally link to an order.
// The same Discord thread + two-way reply sync (via DisputeMessage) applies.
model SupportTicket {
  id               String   @id @default(cuid())
  userId           String // creator: any CUSTOMER or PROVIDER user
  orderId          String? // OPTIONAL linked order
  category         String // ORDER_PROBLEM | PAYMENT | DELIVERY | ACCOUNT | APP_BUG | OTHER
  description      String
  status           String   @default("OPEN") // OPEN | RESOLVED | CLOSED
  discordThreadId  String?
  discordChannelId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  messages         DisputeMessage[]
  user             User     @relation("TicketCreator", fields: [userId], references: [id])
  order            Order?   @relation(fields: [orderId], references: [id])
  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([discordThreadId])
  @@index([discordChannelId])
}

// A single message in a dispute's OR support ticket's conversation. Used for
// two-way Discord bridging: customer/station replies created in-app appear
// here, and support replies typed in the Discord thread are appended by the
// incoming webhook as authorRole=STAFF so all parties see them.
model DisputeMessage {
  id         String         @id @default(cuid())
  // Exactly one parent is set: a dispute OR a support ticket. Keeping it in a
  // single table lets the two-way Discord bridge and the in-app conversation
  // renderer share one message stream (Aug 18 -> Aug 19). Prisma needs both FKs
  // nullable; app code + a CHECK enforce exclusivity.
  disputeId  String?
  ticketId   String?
  authorRole String // CUSTOMER | STATION | ADMIN | STAFF
  authorName String
  content    String
  createdAt  DateTime       @default(now())
  dispute    Dispute?       @relation(fields: [disputeId], references: [id])
  ticket     SupportTicket? @relation(fields: [ticketId], references: [id])
  @@index([disputeId])
  @@index([ticketId])
}

// ─── AUDIT LOG (Phase 1, owner audit-trail request) ───
// System-wide WHO-did-WHAT-WHEN capture for users, stations, admins.
// actorId/entityId are plain string references (NO FK relations) so rows
// survive user/station deletion. Phase 2 (Discord delivery) reads this table.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String? // CUSTOMER | PROVIDER | ADMIN | STAFF | SYSTEM
  action     String // machine-readable, e.g. "order.status_change"
  entityType String? // user | station | order | payout | dispute | supportTicket | staff | review | crash
  entityId   String?
  details    String? // compact JSON context (before/after, amounts, names)
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model Payout {
  id                 String       @id @default(cuid())
  stationId          String
  periodStart        DateTime
  periodEnd          DateTime
  grossCentavos      Int
  commissionCentavos Int
  processingFeeCentavos Int @default(0)
  disbursementFeeCentavos Int?
  heldCentavos       Int
  adjustmentCentavos Int          @default(0)
  netCentavos        Int
  method             String       @default("MANUAL_BANK_TRANSFER")
  status             String       @default("DRAFT")
  providerPayoutId   String?
  transferReference  String?
  failureMessage     String?
  paymongoTransactionId   String? // PayMongo wallet_transaction id (wallet_tr_...)
  paymongoReferenceNumber String? // PayMongo reference_number, used for reconciliation
  paymongoStatus          String? // pending | succeeded | failed
  paymongoError           String? // provider_error / failure message from PayMongo
  createdAt          DateTime     @default(now())
  approvedAt         DateTime?
  paidAt             DateTime?
  station            Station      @relation(fields: [stationId], references: [id])
  payoutItems        PayoutItem[]

  @@unique([stationId, periodStart, periodEnd])
  @@index([stationId, status])
}

model OtpCode {
  id         String   @id @default(cuid())
  userId     String
  purpose    String
  codeHash   String
  codeEncrypted String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  @@index([userId, purpose])
}

model PayoutItem {
  id                 String   @id @default(cuid())
  payoutId           String
  orderId            String   @unique
  grossCentavos      Int
  commissionCentavos Int
  processingFeeCentavos Int @default(0)
  heldCentavos       Int
  netCentavos        Int
  createdAt          DateTime @default(now())
  payout             Payout   @relation(fields: [payoutId], references: [id])
  order              Order    @relation(fields: [orderId], references: [id])

  @@index([payoutId])
}
